# ---- LLM (optional; without a key the system runs in extractive/offline mode) ----
LLM_PROVIDER=none            # anthropic | openai | groq | gemini | none
LLM_MODEL=                   # blank = provider default
LLM_VERIFIER_MODEL=          # optional separate verifier; Groq example: openai/gpt-oss-120b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Groq default: openai/gpt-oss-20b (set LLM_PROVIDER=groq)
GEMINI_API_KEY=
# ---- security ----
JWT_SECRET=please-change-this-to-a-long-random-string
# ---- optional ----
SEMANTIC_SCHOLAR_API_KEY=
GROBID_URL=                  # e.g. http://grobid:8070 (docker compose --profile grobid up)
EMBEDDING_BACKEND=auto       # auto | bge | hash
